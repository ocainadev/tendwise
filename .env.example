# Copy to .env and fill in the values. Never commit .env.
# cp .env.example .env

# --- Database (PostgreSQL 16 + pgvector) ---
POSTGRES_DB=tendwise
POSTGRES_USER=tendwise
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- business-service ---
# Key that agent-service sends in the X-Api-Key header.
BUSINESS_SERVICE_API_KEY=
BUSINESS_SERVICE_URL=http://business-service:8080
# Platform admin (the operator), created on startup if it does not exist yet.
# Left empty, no admin is created (a warning is logged). Use a long, unique password.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# Local demo only: when set, creates owner@<slug>.test and agent@<slug>.test for
# joes-pizza and denim-corner with this password. Leave empty in production.
DEMO_USERS_PASSWORD=
# Panel login (ADR 0003). Required: the Ed25519 private key that signs the access
# tokens, as one line of base64 (PKCS#8). Generate it with OpenSSL 3 (macOS: Homebrew
# openssl@3; the system LibreSSL has no Ed25519):
#   openssl genpkey -algorithm ed25519 -outform DER | base64 | tr -d '\n'
# or with Docker:
#   docker run --rm alpine:3.20 sh -c 'apk add -q openssl >/dev/null && openssl genpkey -algorithm ed25519 -outform DER | base64 | tr -d "\n"'
# Each environment gets its own key. Never commit it.
AUTH_JWT_PRIVATE_KEY=
# Secure flag on the session cookies (default true). Browsers accept Secure cookies on
# http://localhost; set false only for plain http on another host (e.g. a LAN IP).
AUTH_COOKIE_SECURE=

# --- agent-service ---
# docker compose builds DATABASE_URL from the POSTGRES_* values above. Set
# DATABASE_URL yourself only when running agent-service outside compose, e.g.
# DATABASE_URL=postgresql://tendwise:<password>@localhost:5432/tendwise

# Key required by POST /api/v1/admin/ingest.
ADMIN_API_KEY=

# LLM provider: anthropic | openai (gemini planned). Empty values use the defaults:
# LLM_PROVIDER=anthropic, LLM_MAX_TOKENS=512, and LLM_MODEL = the provider's small,
# low-cost model: claude-haiku-5-5 (anthropic) or gpt-6-luna (openai).
# Only the selected provider's key is needed: ANTHROPIC_API_KEY or OPENAI_API_KEY.
# agent-service starts without an API key; only LLM calls fail.
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Embeddings, computed locally with fastembed (no API key). Empty values use the
# defaults: EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2,
# EMBEDDING_DIMENSIONS=384 (must match the vector(N) column in agent-service/migrations).
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
# Only outside compose: where the model is downloaded (default agent-service/.cache/fastembed)
# and the folder holding businesses/<slug>/*.md (default ../data, relative to agent-service/).
# EMBEDDING_CACHE_DIR=
# DATA_DIR=

# Retrieval. Empty values use the defaults: RAG_TOP_K=5 chunks per question,
# RAG_MIN_SIMILARITY=0.30 (cosine similarity 0-1; chunks under it are dropped).
RAG_TOP_K=
RAG_MIN_SIMILARITY=

# Cost control
LLM_MAX_TOKENS=

# Retention: `scripts/report.py --purge` deletes conversations older than this
# many days, with their turns and agent memory. Empty uses the default (90).
CONVERSATION_RETENTION_DAYS=
