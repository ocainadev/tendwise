# Copy to .env and fill in the values. Never commit .env.
# cp .env.example .env

# --- Database (PostgreSQL 16 + pgvector) ---
POSTGRES_DB=tendwise
POSTGRES_USER=tendwise
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- business-service ---
# Key that agent-service sends in the X-Api-Key header.
BUSINESS_SERVICE_API_KEY=
BUSINESS_SERVICE_URL=http://business-service:8080

# --- agent-service ---
# docker compose builds DATABASE_URL from the POSTGRES_* values above. Set
# DATABASE_URL yourself only when running agent-service outside compose, e.g.
# DATABASE_URL=postgresql://tendwise:<password>@localhost:5432/tendwise

# Key required by POST /api/v1/admin/ingest.
ADMIN_API_KEY=

# LLM provider: anthropic (openai | gemini planned). Empty values use the defaults:
# LLM_PROVIDER=anthropic, LLM_MODEL=claude-haiku-5-5 (fast, low cost), LLM_MAX_TOKENS=512.
# agent-service starts without an API key; only LLM calls fail.
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Embeddings, computed locally with fastembed (no API key). Empty values use the
# defaults: EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2,
# EMBEDDING_DIMENSIONS=384 (must match the vector(N) column in agent-service/migrations).
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
# Only outside compose: where the model is downloaded (default agent-service/.cache/fastembed)
# and the folder holding businesses/<slug>/*.md (default ../data, relative to agent-service/).
# EMBEDDING_CACHE_DIR=
# DATA_DIR=

# Retrieval. Empty values use the defaults: RAG_TOP_K=5 chunks per question,
# RAG_MIN_SIMILARITY=0.30 (cosine similarity 0-1; chunks under it are dropped).
RAG_TOP_K=
RAG_MIN_SIMILARITY=

# Cost control
LLM_MAX_TOKENS=
